+/// The host `Activity`, since `ndk_context` may only hold the `Application`.
+static ACTIVITY: OnceLock<usize> = OnceLock::new();
+
+/// Launch pickers from this `Activity` (a JNI global reference) instead of
+/// the `ndk_context` context, which cannot start activities for a result.
+pub fn set_activity(activity: *mut std::ffi::c_void) {
+    let _ = ACTIVITY.set(activity as usize);
+}
+
+fn activity(ctx: &ndk_context::AndroidContext) -> *mut std::ffi::c_void {
+    ACTIVITY
+        .get()
+        .map_or_else(|| ctx.context(), |&activity| activity as *mut std::ffi::c_void)
+}
